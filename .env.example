# ─── OpenAI (instance self-hosted) ───────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://toknroutertybot.tybotflow.com/
OPENAI_MODEL=gpt-5.6-luna           # optionnel (défaut : gpt-5.6-luna)

# ─── SmartDB (API REST tybotflow — backend de données côté client) ───────────
# Le backend lit/écrit les données via l'API REST SmartDB (NocoDB), pas Supabase.
SMARTDB_BASE_URL=https://api.tybotflow.com/api/v1
SMARTDB_API_KEY=twx_...              # clé API fournie par le client (header Authorization)
SMARTDB_BASE_ID=pmrlw1xde7g9e        # base « Ads Management »

# ─── Supabase (hérité — optionnel, plus requis) ──────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ─── JWT (optionnel — auto-généré si absent) ─────────────────────────────────
JWT_SECRET=

# ─── Login délégué à la plateforme du client (optionnel) ─────────────────────
# Si renseigné, /auth/login authentifie contre l'endpoint du client (tybotflow)
# au lieu de la table `users` locale ; l'utilisateur est rattaché en local par
# email. Vide → login 100 % local (défaut).
CLIENT_AUTH_URL=https://api.tybotflow.com/api/v1/auth/login
# Token de service éventuel exigé par l'endpoint du client (en-tête Authorization).
# Laisser vide si l'endpoint n'en demande pas.
CLIENT_AUTH_TOKEN=

# ─── Workspace tybotflow (agents conversationnels) ───────────────────────────
# Id du workspace dont on liste les « smart services » (agents). Sert à construire
# la liste des bot_id ciblables via `@nom` dans le chat. 63 = workspace fizzy.
WORKSPACE_ID=63
CHATBOT_WORKSPACES_URL=https://api.tybotflow.com/api/v1/chatbots/getAllChatbotsOfWorkspace

# ─── UCC (agents externes, ex. « fizzy ») ────────────────────────────────────
# API webhook : le POST ci-dessous ne renvoie pas la réponse du bot ; elle arrive
# par l'événement WebSocket `bot-message`, dans la room = l'id de conversation
# renvoyé par START_CONVERSATION_URL.
# ⚠️ Les deux premières sont À COMPLÉTER (chemin exact inconnu, base connue :
# https://meta-ucc.tybot.ma/ucc/v…). Vides → le chat UCC est désactivé.
UCC_SEND_URL=https://meta-ucc.tybot.ma/ucc/v
# WebSocket où le bot émet `bot-message`, après avoir rejoint la room (= l'id de
# conversation renvoyé par START_CONVERSATION_URL). ⚠️ À COMPLÉTER : c'est un
# serveur distinct (wss://…), pas l'endpoint REST start-conversation.
UCC_WS_URL=
UCC_HOST=https://app.tybotflow.com
START_CONVERSATION_URL=https://api.tybotflow.com/api/v1/conversations/start-conversation

# ─── Chat public (optionnel) ─────────────────────────────────────────────────
# /chat et /conversations sont publics : sans credential, l'agent agit au nom de
# l'utilisateur de démo ci-dessous. L'appelant externe (Botpress) identifie la
# personne via le champ `user_id` du corps de /chat.
CHAT_API_USER_ID=5

# ─── Observabilité (optionnel) ───────────────────────────────────────────────
# DSN Sentry. Vide → Sentry désactivé (dev local, aucun appel réseau).
SENTRY_DSN=
# Environnement signalé à Sentry. Défaut : development.
ENV=development

# ─── Rate limiter (optionnel) ─────────────────────────────────────────────────
# Redis partagé entre workers. Absent/injoignable → rate limit désactivé
# (fail-open), le service reste up. Requis pour un déploiement multi-worker.
REDIS_URL=redis://localhost:6379/0

# ─── Worker de sync Meta → Supabase (optionnel) ──────────────────────────────
# Intervalle entre deux synchronisations automatiques (minutes). Défaut : 20.
FB_SYNC_INTERVAL_MINUTES=20
# Lancer un sync immédiat au démarrage du serveur (true/false). Défaut : true.
FB_SYNC_ON_STARTUP=true

# Note : les credentials Meta (token, ad account, page, pixel) sont stockés PAR
# COMPTE dans la table Supabase `meta_accounts` (page Settings), pas ici.
